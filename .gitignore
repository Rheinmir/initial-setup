# Python bytecode — lọt vào từ 33e1484 do `git add -A` khi .gitignore thiếu pattern
__pycache__/
*.pyc

# Root-level raw/ is obsolete (moved to llmwiki/raw/).
# Block accidental recreation here.
/raw/

# Session-output artifacts — keep LOCAL, drop from REMOTE (goal 2026-06-28).
# Files stay on disk; index.md rows kept so local index_sync (R3) still passes.
llmwiki/html/*.html
!llmwiki/html/overstack.html
# v4: ARTIFACT travel — đồ thị wiki+code của dự án đi theo git (user coi được)
!llmwiki/html/wiki-graph.html
llmwiki/html/archive/
# v4: council report = dev-artifact của dự án NÀY, ignore (ship user sạch)
llmwiki/html/council/
# framework's OWN wiki now lives in the kit (fdk/wiki); llmwiki/wiki is the per-project template demo
fdk/wiki/sources/draft/*.md
!fdk/wiki/sources/draft/README.md
!fdk/wiki/sources/draft/_template.md
fdk/wiki/sources/draft/archive/
fdk/wiki/draft/*.md
fdk/wiki/draft/orca/*.md

# generated artifact manifest (local, per artifacts.config.yaml manifest.tracked:false)
fdk/MANIFEST.json
fdk/MANIFEST.md

# code-logger raw event history (local)
harness/metrics/events.jsonl
harness/metrics/agent-trace.jsonl
harness/metrics/unknowns.json
graph.db
.graph-agent/

# failure-flywheel raw failure history (local)
harness/metrics/failures.jsonl

# framework-dev docs-site renders (local-only; bản chất bền ở fdk/wiki)
fdk/html/*.html
harness/metrics/cost-by-session.json
harness/metrics/tokens.jsonl
.DS_Store
# harness/metrics/tasks.json — KHONG ignore nua (2026-08-03).
# So task la nguon chan ly de validate `task:` trong draft DA COMMIT. De no local-only thi
# clone moi co so RONG, va moi task-ref trong draft lich su thanh 'tro task la' ngay khi ai do
# mint task dau tien — do that trong phien 03/08: 0 loi -> 18 loi chi vi file duoc tao ra.

harness/metrics/query-log.jsonl

# sweep-gate baseline (local)
harness/metrics/sweep-marker.json

# ephemeral — không push (council 2026-07-03)
scratchpad/
fdk/docs/superpowers/

# flywheel success-flywheel raw history (local)
harness/metrics/successes.jsonl
llmwiki/wiki/sources/draft/archive/

# mem-rank local memory store
harness/metrics/memory.jsonl

# Stop hook debounce state (p-45: build-wiki-graph 49s + medic --ci 26s fired ~mọi lượt)
harness/metrics/.stop-debounce.json

# okf-scan context receipts
harness/metrics/context-receipts.jsonl

# .overstack/kit — sandbox clone overstack (fdk-kit.sh pull), local-only
.overstack/kit/

# handover tự sinh khi phiên hết ngân sách (per-terminal, đã consume) + artifact visual-check của viewport-check
llmwiki/handover/
*.visual-check.*
